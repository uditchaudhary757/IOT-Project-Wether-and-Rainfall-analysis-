            document.getElementById('tab-slides').classList.add('hidden');
            document.getElementById('tab-data').classList.add('hidden');

            document.getElementById('nav-dashboard').className = "px-4 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:text-white hover:bg-slate-800";
            document.getElementById('nav-slides').className = "px-4 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:text-white hover:bg-slate-800";
            document.getElementById('nav-data').className = "px-4 py-2 rounded-lg text-sm font-medium transition text-slate-300 hover:text-white hover:bg-slate-800";

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`nav-${tabName}`).className = "px-4 py-2 rounded-lg text-sm font-medium transition bg-sky-600 text-white";
        }

        // Render Data Charts
        function renderCharts(dataset) {
            const labels = dataset.map(d => d.year);
            const rainfall = dataset.map(d => d.rainfall);
            const temps = dataset.map(d => d.temp);

            // Annual Bar Chart
            const ctxAnnual = document.getElementById('annualChart').getContext('2d');
            if (annualChartInstance) annualChartInstance.destroy();
            annualChartInstance = new Chart(ctxAnnual, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Rainfall (mm)',
                        data: rainfall,
                        backgroundColor: rainfall.map(v => v > 1200 ? '#0284c7' : v < 800 ? '#f59e0b' : '#38bdf8'),
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // Seasonal Doughnut Chart
            const ctxSeasonal = document.getElementById('seasonalChart').getContext('2d');
            if (seasonalChartInstance) seasonalChartInstance.destroy();
            seasonalChartInstance = new Chart(ctxSeasonal, {
                type: 'doughnut',
                data: {
                    labels: ['Monsoon (Jul-Sep)', 'Pre-Monsoon (Apr-Jun)', 'Post-Monsoon (Oct-Dec)', 'Winter (Jan-Mar)'],
                    datasets: [{
                        data: [84, 10, 3, 3],
                        backgroundColor: ['#0284c7', '#38bdf8', '#fbbf24', '#94a3b8']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // Monthly Profile Line Chart
            const ctxMonthly = document.getElementById('monthlyChart').getContext('2d');
            if (monthlyChartInstance) monthlyChartInstance.destroy();
            monthlyChartInstance = new Chart(ctxMonthly, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Avg Rainfall (mm)',
                        data: monthlyData,
                        borderColor: '#0284c7',
                        backgroundColor: 'rgba(2, 132, 199, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // Temp vs Rain Mixed Chart
            const ctxTempRain = document.getElementById('tempRainChart').getContext('2d');
            if (tempRainChartInstance) tempRainChartInstance.destroy();
            tempRainChartInstance = new Chart(ctxTempRain, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Rainfall (mm)',
                            data: rainfall,
                            backgroundColor: 'rgba(56, 189, 248, 0.5)',
                            yAxisID: 'y'
                        },
                        {
                            type: 'line',
                            label: 'Avg Temp (°C)',
                            data: temps,
                            borderColor: '#ef4444',
                            borderWidth: 2,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { position: 'left', title: { display: true, text: 'Rainfall (mm)' } },
                        y1: { position: 'right', min: 20, max: 30, title: { display: true, text: 'Temp (°C)' }, grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        // Filter Logic
        function filterData() {
            const val = document.getElementById('yearFilter').value;
            let filtered = weatherData;

            if (val === 'recent') {
                filtered = weatherData.filter(d => d.year >= 2021);
            } else if (val === 'past') {
                filtered = weatherData.filter(d => d.year <= 2020);
            }

            // Recalculate KPI
            const avg = Math.round(filtered.reduce((acc, curr) => acc + curr.rainfall, 0) / filtered.length);
            document.getElementById('kpi-avg-rain').innerText = avg.toLocaleString();

            renderCharts(filtered);
        }

        // Populate Raw Data Table
        function populateTable(dataset) {
            const tbody = document.getElementById('datasetTableBody');
            tbody.innerHTML = dataset.map(row => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 font-bold text-slate-900">${row.year}</td>
                    <td class="px-6 py-4">${row.rainfall} mm</td>
                    <td class="px-6 py-4">${row.rainyDays} days</td>
                    <td class="px-6 py-4">${row.temp} °C</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${
                            row.status.includes('Deficit') ? 'bg-amber-100 text-amber-800' : 
                            row.status.includes('Excess') ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800'
                        }">
                            ${row.status}
                        </span>
                    </td>
                </tr>
            `).join('');
        }

        // Slide Deck Navigation
        function renderSlide(index) {
            const slide = slides[index];
            document.getElementById('slide-tag').innerText = slide.tag;
            document.getElementById('slide-title').innerText = slide.title;
            document.getElementById('slide-body').innerHTML = slide.body;
            document.getElementById('slide-indicator').innerText = `Slide ${index + 1} / ${slides.length}`;
        }

        function prevSlide() {
            if (currentSlide > 0) {
                currentSlide--;
                renderSlide(currentSlide);
            }
        }

        function nextSlide() {
            if (currentSlide < slides.length - 1) {
                currentSlide++;
                renderSlide(currentSlide);
            }
        }


        // IoT readings: fetched from the Python Flask backend.
        async function updateIoTReadings() {
            const statusText = document.getElementById('iot-status-text');
            const statusDot = document.getElementById('iot-status-dot');

            try {
                const response = await fetch('/api/readings');
                if (!response.ok) throw new Error('Server response was not successful');
                const data = await response.json();

                document.getElementById('sensor-temp').textContent = data.temperature.toFixed(1);
                document.getElementById('sensor-humidity').textContent = data.humidity.toFixed(1);
                document.getElementById('sensor-rain').textContent = data.rainfall.toFixed(1);
                document.getElementById('sensor-soil').textContent = data.soil_moisture.toFixed(0);
                document.getElementById('sensor-water').textContent = data.water_level.toFixed(1);

                statusText.textContent = 'Server connected • Demo data';
                statusText.className = 'font-semibold text-emerald-700';
                statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
                document.getElementById('iot-last-updated').textContent =
                    'Updated: ' + new Date(data.timestamp).toLocaleTimeString();
            } catch (error) {
                statusText.textContent = 'Backend not connected';
                statusText.className = 'font-semibold text-red-700';
                statusDot.className = 'h-2.5 w-2.5 rounded-full bg-red-500';
                document.getElementById('iot-last-updated').textContent = 'Start app.py to load readings';
                console.error('Could not load IoT readings:', error);
            }
        }

        // CSV Export Function
        function downloadCSV() {
            let csv = 'Year,Rainfall_mm,Rainy_Days,Avg_Temp_C,Status\n';
            weatherData.forEach(r => {
                csv += `${r.year},${r.rainfall},${r.rainyDays},${r.temp},"${r.status}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', 'Bareilly_Rainfall_Analysis_2016_2025.csv');
            a.click();
        }
    </script>
